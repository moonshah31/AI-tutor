# Explicit browser origins allowed to call the API. Never use a wildcard in production.
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_tutor
APP_ENV=development
LOG_LEVEL=INFO
# Generate a unique 32-byte+ value for each environment; never expose it to the frontend.
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Keep this key on the backend only. It must never be added to frontend environment files.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Document storage. Local keeps development behavior unchanged.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./storage/documents
# Set the backend to r2 and provide credentials only in the deployment's secret settings.
R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
R2_BUCKET=replace-with-private-bucket-name
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
